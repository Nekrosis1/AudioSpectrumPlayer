{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "C#: AudioSpectrumPlayer.Avalonia",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia/AudioSpectrumPlayer.Avalonia.csproj",
			"launchConfigurationId": "TargetFramework=;AudioSpectrumPlayer.Avalonia"
		},
		{
			// Uses the classic "coreclr" launcher (not "dotnet") because only it
			// supports passing "args". Simulates "Open with": the file path is passed
			// as the first arg, exactly as the OS would. You're prompted for the path
			// on launch (see "inputs" below).
			"name": "C#: AudioSpectrumPlayer.Avalonia - open file arg",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia/bin/Debug/net10.0/AudioSpectrumPlayer.Avalonia.dll",
			"cwd": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia",
			"args": [
				"${input:audioFilePath}"
			],
			"stopAtEntry": false,
			"console": "internalConsole"
		}
	],
	"inputs": [
		{
			"id": "audioFilePath",
			"type": "promptString",
			"description": "Absolute path to the audio file to auto-load on launch",
			"default": "/home/nekrosis/Music/Test/Alcohol.mp3"
		}
	]
}
