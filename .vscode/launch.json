{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Avalonia (Linux)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia/bin/Debug/net10.0/AudioSpectrumPlayer.Avalonia.dll",
			"args": [],
			"cwd": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia",
			"stopAtEntry": false,
			"console": "internalConsole"
		},
		{
			"name": "Debug Avalonia (Linux) - open file arg",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia/bin/Debug/net10.0/AudioSpectrumPlayer.Avalonia.dll",
			// Simulates "Open with": the file path is passed as the first arg, exactly as
			// the OS would. You're prompted for the path on launch (see "inputs" below).
			"args": [
				"${input:audioFilePath}"
			],
			"cwd": "${workspaceFolder}/AudioSpectrumPlayer.Avalonia",
			"stopAtEntry": false,
			"console": "internalConsole"
		},
		{
			"name": "Debug WinUI3 (Windows only)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build-winui3",
			"program": "${workspaceFolder}/AudioSpectrumPlayer/bin/Debug/net9.0-windows10.0.19041.0/win-x64/AudioSpectrumPlayer.exe",
			"args": [],
			"cwd": "${workspaceFolder}/AudioSpectrumPlayer",
			"stopAtEntry": false,
			"console": "internalConsole"
		}
	],
	"inputs": [
		{
			"id": "audioFilePath",
			"type": "promptString",
			"description": "Absolute path to the audio file to auto-load on launch",
			"default": "/home/nekrosis/Music/test.mp3"
		}
	]
}
